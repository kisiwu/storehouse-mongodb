{
  "name": "@storehouse/mongodb",
  "version": "3.0.1",
  "description": "MongoDB manager for @storehouse/core",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "doc": "typedoc",
    "build": "tsc",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write .",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check .",
    "lint": "eslint .",
    "test": "cross-env TS_NODE_PROJECT=test/tsconfig.json kaukau -r ts-node/register --config kaukau-src.mjs",
    "test:lib": "kaukau --config kaukau-lib.mjs",
    "test:local": "dotenvx run -f .env.test -- cross-env TS_NODE_PROJECT=test/tsconfig.json kaukau --require ts-node/register --config kaukau-src.mjs",
    "test:lib:local": "dotenvx run -f .env.test -- kaukau --config kaukau-lib.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/storehouse-mongodb.git"
  },
  "keywords": [
    "storehouse",
    "mongodb"
  ],
  "author": "demingongo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kisiwu/storehouse-mongodb/issues"
  },
  "homepage": "https://kisiwu.github.io/storehouse/mongodb/latest/",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-mocha": "^12.0.2",
    "kaukau": "^6.0.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@storehouse/core": "^2.1.0",
    "mongodb": "^7.8.0"
  },
  "dependencies": {
    "@novice1/logger": "^2.0.1",
    "tslib": "^2.9.1"
  }
}